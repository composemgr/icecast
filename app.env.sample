# Icecast app.env.sample
# Copy to app.env and customize

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=myhostname
BASE_DOMAIN_NAME=example.com

# Icecast admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password

# Shared stream/relay/source password
APP_SECRET_KEY=changeme_stream_password

# Icecast location tag
ICECAST_LOCATION=USA

# Your organization name (used in stream descriptions)
APP_ORG_NAME=MyOrg
